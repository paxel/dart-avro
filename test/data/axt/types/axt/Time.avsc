{
  "type": "record",
  "name": "Time",
  "namespace": "axt",
  "doc": "A time of day on the wall clock, to the millisecond, without a date and without a time zone, such as 07:30 for an alarm. Defined in spec/time.md. Its schema never changes.",
  "fields": [
    {
      "name": "hour",
      "type": "int",
      "doc": "The hour, 0 to 23."
    },
    {
      "name": "minute",
      "type": "int",
      "doc": "The minute, 0 to 59."
    },
    {
      "name": "second",
      "type": "int",
      "doc": "The second, 0 to 59; a leap second is not written as 60. 0 when the time is given to the minute."
    },
    {
      "name": "millisecond",
      "type": "int",
      "doc": "The millisecond, 0 to 999. 0 when the time is given to the second or the minute."
    }
  ]
}
