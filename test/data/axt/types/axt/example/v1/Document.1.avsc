{
  "type": "record",
  "name": "Document",
  "namespace": "axt.example.v1",
  "doc": "A document: a file with a title, such as a scanned invoice, a certificate or a photo.",
  "axt.version": 1,
  "axt.title": "title",
  "axt.label": "Document",
  "axt.label_translations": {
    "de": "Dokument"
  },
  "axt.help": "A file with a title, such as a scanned invoice, a certificate or a photo.",
  "axt.help_translations": {
    "de": "Eine Datei mit Titel, etwa eine eingescannte Rechnung, eine Bescheinigung oder ein Foto."
  },
  "axt.emoji": "📄",
  "fields": [
    {
      "name": "title",
      "type": "string",
      "default": "",
      "doc": "What the document is, as plain text on one line.",
      "axt.label": "Title",
      "axt.label_translations": {
        "de": "Titel"
      },
      "axt.help": "What the document is, on one line.",
      "axt.help_translations": {
        "de": "Was das Dokument ist, in einer Zeile."
      },
      "axt.emoji": "🏷️"
    },
    {
      "name": "file_name",
      "type": "string",
      "default": "",
      "doc": "The file's name with its extension, such as invoice-2026-11.pdf. Empty when not known.",
      "axt.label": "File name",
      "axt.label_translations": {
        "de": "Dateiname"
      },
      "axt.help": "The file's name with its extension, such as invoice-2026-11.pdf.",
      "axt.help_translations": {
        "de": "Der Name der Datei mit Endung, etwa invoice-2026-11.pdf."
      },
      "axt.emoji": "🗂️",
      "axt.advanced": true
    },
    {
      "name": "media_type",
      "type": "string",
      "default": "application/octet-stream",
      "doc": "The media type of content as in RFC 6838, such as application/pdf or image/jpeg, without parameters.",
      "axt.label": "File type",
      "axt.label_translations": {
        "de": "Dateityp"
      },
      "axt.help": "The media type of the file, such as application/pdf.",
      "axt.help_translations": {
        "de": "Der Medientyp der Datei, etwa application/pdf."
      },
      "axt.emoji": "🧾",
      "axt.format": "media-type",
      "axt.placeholder": "application/pdf",
      "axt.advanced": true
    },
    {
      "name": "content",
      "type": "bytes",
      "default": "",
      "doc": "The file's content. The whole message, this record included, must stay within the message limit of the AXT envelope.",
      "axt.label": "File",
      "axt.label_translations": {
        "de": "Datei"
      },
      "axt.help": "The file itself.",
      "axt.help_translations": {
        "de": "Die Datei selbst."
      },
      "axt.emoji": "📎"
    },
    {
      "name": "dated",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Date",
          "namespace": "axt",
          "doc": "A calendar date of the proleptic Gregorian calendar, of which a part may be unknown, such as a birthday without a year (null, 5, 3), a year alone (2019, null, null) or a month of a year (2027, 3, null). At least one part is not null, and a day has its month. Defined in spec/time.md. Its schema never changes.",
          "fields": [
            {
              "name": "year",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The year, 1 to 9999. Null when the year is not known or does not matter."
            },
            {
              "name": "month",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The month of the year, 1 (January) to 12 (December). Null when the month is not known; then day is null as well."
            },
            {
              "name": "day",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The day of the month, 1 to the number of days of the month: of that year when the year is known, otherwise of a leap year, so that 29 February is valid without a year. Null when the day is not known."
            }
          ]
        }
      ],
      "default": null,
      "doc": "The date the document bears, such as the date of an invoice, or only its month or year where it names no day. Null when it bears none.",
      "axt.label": "Date",
      "axt.label_translations": {
        "de": "Datum"
      },
      "axt.help": "The date the document bears, such as the date of an invoice.",
      "axt.help_translations": {
        "de": "Das Datum, das das Dokument trägt, etwa das Datum einer Rechnung."
      },
      "axt.emoji": "📅"
    },
    {
      "name": "notes",
      "type": "string",
      "default": "",
      "doc": "Free notes on the document, as plain text; lines are separated by LF. Empty when there are none.",
      "axt.label": "Notes",
      "axt.label_translations": {
        "de": "Notizen"
      },
      "axt.help": "Anything else about the document.",
      "axt.help_translations": {
        "de": "Alles Weitere zum Dokument."
      },
      "axt.emoji": "📝",
      "axt.multiline": true
    }
  ]
}
