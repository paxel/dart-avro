{
  "private": true,
  "type": "module",
  "scripts": {
    "site": "node scripts/build-site.js",
    "site:all": "node scripts/build-site-all.js",
    "site:test": "node --test tests/site/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='scripts/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/site/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
