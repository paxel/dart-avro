<?xml version="1.0" encoding="UTF-8"?>
<!-- The Java side of the benchmark comparison (avro-1036): Apache Avro's generic reader and
     writer on the cases of tool/bench/bench.dart. Not a part of the package; gates.toml keeps
     it out of the gates' stacks. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>bench</groupId>
  <artifactId>avro-bench</artifactId>
  <version>1</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Pinned above what avro 1.12.1 brings, for the advisories OSV lists against jackson 2.20.0
       and snappy-java 1.1.10.8: the lowest versions that fix them all. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.7</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>1.12.1</version>
    </dependency>
    <!-- Optional dependencies of avro, needed by the snappy and zstandard codecs: zstd-jni as
         avro 1.12.1 is built with, snappy-java one patch above it for its advisories. -->
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
      <version>1.1.10.9</version>
    </dependency>
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>1.5.7-4</version>
    </dependency>
  </dependencies>
</project>
